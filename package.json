{
  "name": "territory-run-backend",
  "version": "1.0.0",
  "description": "TerritoryRun — Complete Backend (API Gateway + All Services)",
  "main": "api-gateway/index.js",
  "scripts": {
    "start":            "node api-gateway/index.js",
    "dev":              "nodemon api-gateway/index.js",
    "test":             "jest --runInBand --forceExit",
    "test:unit":        "jest tests/algorithms.test.js --runInBand",
    "test:integration": "jest tests/integration --runInBand --forceExit",
    "cron:decay":       "node utils/decay.warning.cron.js",
    "cron:leaderboard": "node utils/leaderboard.cron.js",
    "cron:blockchain":  "node utils/blockchain.cron.js",
    "cron:rag":         "node utils/rag.ingest.cron.js",
    "seed:achievements": "node -e \"require('./config/db').connectDB().then(() => require('./user-service/achievements').seedAchievementDefs()).then(process.exit)\"",
    "lint":             "eslint . --ext .js"
  },
  "dependencies": {
    "@langchain/community":       "^0.0.40",
    "@langchain/core":            "^0.1.0",
    "@solana/web3.js":            "^1.89.1",
    "bcrypt":                     "^5.1.1",
    "cors":                       "^2.8.5",
    "dotenv":                     "^16.3.1",
    "express":                    "^4.18.2",
    "express-rate-limit":         "^7.1.5",
    "groq-sdk":                   "^0.3.3",
    "h3-js":                      "^4.1.0",
    "helmet":                     "^7.1.0",
    "jsonwebtoken":                "^9.0.2",
    "langchain":                  "^0.1.0",
    "mongoose":                   "^8.0.0",
    "passport":                   "^0.7.0",
    "passport-apple":             "^2.0.2",
    "passport-google-oauth20":    "^2.0.0",
    "redis":                      "^4.6.11",
    "socket.io":                  "^4.6.2"
  },
  "devDependencies": {
    "jest":                       "^29.7.0",
    "nodemon":                    "^3.0.2",
    "supertest":                  "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout":     30000
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
