# ══════════════════════════════════════════════════════════
# TERRITORY RUN — Master Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ══════════════════════════════════════════════════════════

# ── BACKEND VARIABLES ──────────────────────────────────────

# MongoDB Atlas (Free: 512MB)
# Get at: https://www.mongodb.com/cloud/atlas → Create Project → M0 Free Cluster
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/territory-run?appName=TerritoryRun

# JWT Authentication (generate at https://www.uuidgenerator.net/)
JWT_SECRET=generate_a_64_character_random_secret_here_use_uuidgenerator
JWT_REFRESH_SECRET=generate_another_64_character_random_secret_here

# Upstash Redis Cache (Free: 10k commands/day)
# Get at: https://console.upstash.com → Create Database → Copy UPSTASH_REDIS_URL & Token
UPSTASH_REDIS_URL=https://leading-llama-xxxxx.upstash.io
UPSTASH_REDIS_TOKEN=AZkBAAIncDJjY2ExYTA1NGE2OGI0NzJlYTljMDNjNTdjZTFjNGQyNnAyMzkxNjk

# Groq AI API (Free: limited inference)
# Get at: https://console.groq.com → API Keys → Create Key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Storage (Free: 1GB + unlimited downloads)
# Get at: https://supabase.com → Create Project → Copy Project URL & Anon Key
SUPABASE_URL=https://ofvclyckqpwmsxkhvpmo.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_BUCKET=territory-run-storage

# Blockchain — Ethereum Sepolia Testnet (Free — NO CREDIT CARD NEEDED)
# 1. Get Alchemy RPC: https://dashboard.alchemy.com → Create App → Ethereum Sepolia
# 2. Get Private Key: MetaMask → Account Details → Export Private Key
# 3. Get free Sepolia ETH: https://sepoliafaucet.com or https://faucet.quicknode.com
BLOCKCHAIN_NETWORK=sepolia
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/uKiUksazucZlmLgUAI1Qj
WALLET_PRIVATE_KEY=042467a131e561566a968f67028454028f61c6bddf4f3278fcf9901338b5b416

# OAuth — Google (Free)
# Get at: https://console.cloud.google.com → Create OAuth 2.0 Client
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Application Settings
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://territoryrun.vercel.app

# ── FRONTEND VARIABLES ─────────────────────────────────────

# Backend API URLs (Render production endpoints)
NEXT_PUBLIC_API_URL=https://api.territoryrun.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://api.territoryrun.onrender.com

# NextAuth Configuration
NEXTAUTH_SECRET=generate_a_long_random_string_for_nextauth_security
NEXTAUTH_URL=https://territoryrun.vercel.app

# Development Mode (set to false in production)
NEXT_PUBLIC_DEV_MODE=false
NEXT_PUBLIC_DEV_CITY=San%20Francisco
