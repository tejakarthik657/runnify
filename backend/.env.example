# TerritoryRun — Backend Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/territory_run

# JWT secret — use a 64+ char random string
JWT_SECRET=replace_with_a_very_long_random_secret_string_at_least_64_chars

# Upstash Redis (copy from Upstash dashboard → Redis → Connect → Node.js)
UPSTASH_REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Groq API key (for RAG bot) — get from console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Solana RPC endpoint (devnet for dev, mainnet-beta for prod)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Frontend URL (for CORS whitelist)
FRONTEND_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Server port
PORT=4000

# API base URL (for OAuth callbacks)
API_BASE_URL=http://localhost:4000

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple OAuth (get from Apple Developer)
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_BUNDLE_ID=com.territoryrun.app
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_APPLE_PRIVATE_KEY\n-----END PRIVATE KEY-----
