# .env.test — used ONLY during jest runs
NODE_ENV=test

# MongoDB — use local instance for tests
MONGODB_URI=mongodb://localhost:27017/territoryrun_test

# Upstash Redis — mock it completely in tests (no real connection needed)
UPSTASH_REDIS_REST_URL=http://localhost:6379
UPSTASH_REDIS_REST_TOKEN=test_token

# JWT
JWT_SECRET=test_secret_key_not_for_production
JWT_REFRESH_SECRET=test_refresh_secret_not_for_production

# Disable blockchain in tests
SKIP_BLOCKCHAIN=true

# Port
PORT=4001
