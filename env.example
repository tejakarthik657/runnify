# TerritoryRun — Backend Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# JWT secret — use a 64+ char random string
JWT_SECRET=replace_with_a_very_long_random_secret_string_at_least_64_chars

# Upstash Redis (copy from Upstash dashboard → Redis → Connect → Node.js)
UPSTASH_REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Groq API key (for RAG bot)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Solana RPC endpoint (devnet for dev, mainnet-beta for prod)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Supabase Storage (free: 1GB storage + unlimited downloads, NO CREDIT CARD NEEDED!)
# 1. Create account at https://supabase.com (sign up with GitHub)
# 2. Create new project
# 3. Go to Settings → Copy Project URL
# 4. Go to Settings → Copy Anon Key (public key is fine)
# 5. Create storage bucket: click Storage → New Bucket → "Territory-Run-Storage"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_BUCKET=territory-run-storage

# Frontend URL (for CORS whitelist)
FRONTEND_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Server port
PORT=4000
